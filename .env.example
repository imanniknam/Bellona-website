# Copy to .env.local for local work; set the same keys in Vercel → Project → Settings → Environment Variables.

# Public origin, used for canonical URLs, hreflang, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://bellonaagency.com

# "Book a 30-min free call" target (Cal.com, Calendly, …). When empty, the CTA goes to /contact.
BOOKING_URL=

# Contact form → your own n8n / Make webhook. Receives a JSON POST (see README › Contact form).
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the `x-bellona-secret` header so the webhook can reject other callers.
LEAD_WEBHOOK_SECRET=

# Email fallback via Resend, used when the webhook is missing or fails.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Bellona <leads@bellonaagency.com>".
LEAD_FROM_EMAIL=
# Where lead emails go.
LEAD_TO_EMAIL=bellona.ai.team@gmail.com

# Last-resort lead store on this server, used only when the webhook and Resend both fail
# (e.g. international internet is cut). Leads are appended to <dir>/leads-YYYY-MM.jsonl and the visitor is
# told their message was saved but the reply may be slower. Must be persistent disk (not an ephemeral
# container filesystem such as Render free). Leave empty to disable: failed deliveries then show an error.
# Tip for hosting in Iran: point LEAD_WEBHOOK_URL at a self-hosted n8n on the same network.
LEAD_STORE_DIR=

# One public host (proxy.ts). Leave empty until the new site is live on the NEXT_PUBLIC_SITE_URL domain.
# "redirect": other hosts (e.g. bellona-web.onrender.com, www.) 301 to the canonical host, same path.
# "noindex": other hosts are served with X-Robots-Tag: noindex instead.
CANONICAL_HOST_MODE=

# Optional analytics (Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX). Leave empty to load no analytics.
# GA is hosted abroad: during an international cut-off it simply stops recording (the site is unaffected).
NEXT_PUBLIC_ANALYTICS_ID=
